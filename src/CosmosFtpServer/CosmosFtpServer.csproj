<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A plain .NET library: it uses System.Net.Sockets, System.IO and nothing
    from Cosmos. A Cosmos Gen3 kernel runs it on the kernel's network stack
    and VFS through the socket and file plugs, and on a desktop it runs as is,
    which is how the tests drive it.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>CosmosFtpServer</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>CosmosFtpServer</PackageId>
    <Version>2.0.0</Version>
    <Title>CosmosFtpServer</Title>
    <Authors>Cosmos</Authors>
    <Company>Cosmos</Company>
    <Description>FTP server for Cosmos Gen3 kernels.</Description>
    <PackageTags>cosmos;ftp;server;kernel</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/CosmosOS/CosmosFtp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/CosmosOS/CosmosFtp</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../LICENSE.txt" Pack="true" PackagePath="/" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../resources/icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CosmosFtpServer.Tests" />
  </ItemGroup>

</Project>
